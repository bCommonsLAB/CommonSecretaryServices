# API-Keys werden AUSSCHLIESSLICH hier (bzw. über Docker Compose) gepflegt.
# Sie dürfen NICHT in config.yaml stehen und werden nicht im Frontend angezeigt.
OPENAI_API_KEY=your-api-key-here
MISTRAL_API_KEY=your-mistral-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
VOYAGE_API_KEY=your-voyage-key-here
MONGODB_URI=mongodb+srv://xyz@bcommonslab.kh9co.mongodb.net/?retryWrites=true&w=majority&appName=bCommonsLab

# Upload-Limit für Video/Datei-Uploads (MB).
# Lokal (src/api/__init__.py): Default 100, wenn unset.
# Docker (docker-compose.yml): Default 500 via ${MAX_UPLOAD_SIZE_MB:-500}.
# MAX_UPLOAD_SIZE_MB=500

# YouTube: Browsername für yt-dlp --cookies-from-browser.
# Unter Windows: firefox. Edge/Chrome scheitern an App-Bound Encryption.
# Der Browser muss geschlossen sein, sonst ist die Cookie-DB gesperrt.
# YTDLP_COOKIES_FROM_BROWSER=firefox
# Netscape-Cookie-Datei nur für YouTube (nicht die Vimeo-Datei).
# YTDLP_YOUTUBE_COOKIES_FILE=C:/Users/peter.aichner/AppData/Local/commonSecretary/secrets/youtube.cookies.txt

# --- Sicherheit (Anleitung: docs/deployment/dashboard-anmeldung.md) ---------
# Pflicht: Token fuer alle API-Aufrufe. Ohne ihn startet der Dienst nicht.
# Erzeugen: openssl rand -hex 32
SECRETARY_SERVICE_API_KEY=
# Pflicht, sobald das Dashboard genutzt wird: signiert Sitzung und CSRF-Token.
# Je Installation ein eigener Wert: openssl rand -hex 32
FLASK_SECRET_KEY=

# Dashboard-Anmeldung ueber Nextcloud (OIDC). Ohne Anmeldung ist das Dashboard gesperrt.
# DASHBOARD_AUTH_MODE=oidc
# OIDC_ISSUER=https://cloud.example.org
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Oeffentliche Adresse dieser Installation; Ruecksprungadresse = PUBLIC_BASE_URL/auth/callback
# PUBLIC_BASE_URL=https://secretaryservices.example.org
# DASHBOARD_REQUIRED_GROUP=secretary-admins

# Notzugang ohne Nextcloud (Basic Auth). Hash erzeugen mit:
#   python -m src.dashboard.auth hash-password
# Die ausgegebene Zeile (mit Punkten statt $, ohne Anfuehrungszeichen) uebernehmen.
# DASHBOARD_AUTH_MODE=basic
# DASHBOARD_USER=admin
# DASHBOARD_PASSWORD_HASH=pbkdf2:sha256:1000000.<salt>.<hash>

# Nur hinter einem eigenen Reverse Proxy (Traefik/Dokploy): Anzahl der Proxys.
# TRUSTED_PROXY_COUNT=1
# Swagger ohne Anmeldung fuer bestimmte Netze (IPs oder CIDR).
# SWAGGER_IP_WHITELIST=192.168.1.0/24
# Nur lokale Entwicklung: Betrieb ohne Anmeldung ausdruecklich erlauben.
# ALLOW_INSECURE_NO_AUTH=true

# --- MongoDB der mitgelieferten docker-compose.yml (Anleitung: docs/deployment/mongo-migration.md)
# Pflicht fuer `docker compose up`. Passwort nur aus Buchstaben und Ziffern: openssl rand -hex 24
# Die Compose-Datei setzt MONGODB_URI fuer den Container daraus selbst zusammen.
MONGO_ROOT_USER=secretary
MONGO_ROOT_PASSWORD=
# MONGO_DB_NAME=commonsec
