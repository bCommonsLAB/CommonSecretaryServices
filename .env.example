# API-Keys werden AUSSCHLIESSLICH hier (bzw. über Docker Compose) gepflegt.
# Sie dürfen NICHT in config.yaml stehen und werden nicht im Frontend angezeigt.
OPENAI_API_KEY=your-api-key-here
MISTRAL_API_KEY=your-mistral-key-here
OPENROUTER_API_KEY=your-openrouter-key-here
VOYAGE_API_KEY=your-voyage-key-here
MONGODB_URI=mongodb+srv://xyz@bcommonslab.kh9co.mongodb.net/?retryWrites=true&w=majority&appName=bCommonsLab

# Upload-Limit für Video/Datei-Uploads (MB).
# Lokal (src/api/__init__.py): Default 100, wenn unset.
# Docker (docker-compose.yml): Default 500 via ${MAX_UPLOAD_SIZE_MB:-500}.
# MAX_UPLOAD_SIZE_MB=500

# YouTube: Browsername für yt-dlp --cookies-from-browser.
# Unter Windows: firefox. Edge/Chrome scheitern an App-Bound Encryption.
# Der Browser muss geschlossen sein, sonst ist die Cookie-DB gesperrt.
# YTDLP_COOKIES_FROM_BROWSER=firefox
# Netscape-Cookie-Datei nur für YouTube (nicht die Vimeo-Datei).
# YTDLP_YOUTUBE_COOKIES_FILE=C:/Users/peter.aichner/AppData/Local/commonSecretary/secrets/youtube.cookies.txt
